# Copy to config/.env locally; in cloud these come from Secret Manager / job env.
# --- LLM (provider-agnostic via LiteLLM; examples below) ---
LLM_FAST_MODEL=      # analysts/summaries, Haiku-class. e.g. anthropic/claude-haiku-4-5  or vertex_ai/<claude-haiku-model-id>
LLM_SMART_MODEL=     # manager/judge/PM, Sonnet-class. e.g. anthropic/claude-sonnet-4-6  or a Vertex/Gemini equivalent
ANTHROPIC_API_KEY=   # if using Anthropic direct
# VERTEXAI_PROJECT= / VERTEXAI_LOCATION=   # if using Claude or Gemini via Vertex AI
# --- Data (free tiers) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true    # guardrail: asserted at startup
FINNHUB_API_KEY=
FRED_API_KEY=        # M3
REDDIT_CLIENT_ID=    # M3 personal OAuth
REDDIT_CLIENT_SECRET=
# --- Output / delivery ---
REPORTS_BUCKET=      # GCS bucket (empty = write locally)
TELEGRAM_BOT_TOKEN=  # M5
TELEGRAM_CHAT_ID=
DEEP_TICKER_CAP=5
DEBATE_ROUNDS=1
