# Copy to config/.env locally; in cloud these come from Secret Manager / job env.

# --- LLM (provider-agnostic via LiteLLM) -------------------------------------
# Three cost tiers. Values are opaque LiteLLM model strings — swapping provider
# is an env change, never a code change.
#   fast  = the 4 analysts, quick takes, summarisation   (Haiku-class)
#   smart = research manager, risk judge                 (Sonnet-class)
#   deep  = portfolio manager only (M2)                  (Opus-class)
#
# Configured here for Claude on Vertex AI (auth = Application Default
# Credentials, e.g. `gcloud auth application-default login`; no API key).
LLM_FAST_MODEL=vertex_ai/claude-haiku-4-5
LLM_SMART_MODEL=vertex_ai/claude-sonnet-5
LLM_DEEP_MODEL=vertex_ai/claude-opus-5
VERTEXAI_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=global
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=120
#
# Other providers — same three keys, different strings, no code change:
#   anthropic/claude-haiku-4-5   + ANTHROPIC_API_KEY=
#   gemini/gemini-2.5-flash      + GEMINI_API_KEY=
#   ollama/llama3.1              + OLLAMA_API_BASE=http://localhost:11434
# ANTHROPIC_API_KEY=

# --- Data (free tiers) -------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
FINNHUB_API_KEY=

# --- Signal layer (M3) — all optional ----------------------------------------
# Each source skips itself with a visible reason when its key is missing, so a
# partial configuration degrades the report instead of failing the run.
#   FRED_API_KEY     free, instant: https://fredaccount.stlouisfed.org/apikeys
#   SEC_USER_AGENT   required by EDGAR fair access — a descriptive name and a
#                    real contact address. We refuse to invent one for you.
#   Polymarket       public and unkeyed, nothing to set.
FRED_API_KEY=
SEC_USER_AGENT=daybreak-research your.name@example.com
# There is no social-sentiment source. Reddit was the intended fifth and its API
# application was rejected, so nothing here reads retail chatter. The slot stays
# open: any client implementing SignalSource can fill it (StockTwits, Bluesky,
# an approved Reddit key later) by registering in signals/bundle.py, and would
# add its own keys here.

# --- Output / delivery -------------------------------------------------------
# REPORTS_BUCKET mirrors reports/ and journal/ to GCS. Leave empty to stay
# local; set it in cloud, where the container's disk is gone when the job exits
# and the journal is the only benchmark the project has.
REPORTS_BUCKET=

# Email delivery. Unset SMTP_HOST/REPORT_EMAIL_TO and the run still completes —
# delivery reports itself as skipped rather than failing the job.
#   SMTP_APP_PASSWORD  Gmail: a 16-character App Password (Google Account ->
#                      Security -> 2-Step Verification -> App passwords). Your
#                      normal password will be refused.
#   SMTP_PORT          587 = STARTTLS (default), 465 = implicit TLS.
#   SMTP_FROM          defaults to SMTP_USER.
#   REPORT_EMAIL_TO    one address, or several separated by commas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
REPORT_EMAIL_TO=

DEEP_TICKER_CAP=5
DEBATE_ROUNDS=1
